# Groq API Key (Optional — app operates fully with deterministic fallback if left blank)
VITE_GROQ_API_KEY=

# Default Groq model: llama-3.3-70b-versatile or llama-3.1-8b-instant
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Low temperature for factually grounded, reproducible reasoning
VITE_AI_TEMPERATURE=0.1
